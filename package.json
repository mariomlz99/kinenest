{
  "name": "kinenest",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/bundle.mjs && node scripts/serve.mjs",
    "build": "node scripts/bundle.mjs && node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --built",
    "test": "node scripts/installation-assets.mjs --check && node --test tests/*.test.js",
    "test:browser": "node scripts/browser.mjs",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:actions": "node scripts/actions.mjs",
    "test:product": "node scripts/product.mjs",
    "test:tf": "node scripts/tf-runtime-check.mjs && node scripts/tf-visual-check.mjs && node scripts/tf-learning-check.mjs",
    "test:terminal-shortcuts": "node scripts/terminal-shortcuts-check.mjs && node scripts/terminal-wrap-review.mjs",
    "test:tf-review": "node scripts/tf-adversarial-runtime.mjs && node scripts/tf-checker-attacks.mjs && node scripts/tf-session-review.mjs && node scripts/tf-review-ui.mjs",
    "deploy": "wrangler deploy",
    "bundle:installation": "node scripts/installation-assets.mjs",
    "test:odometry": "node scripts/odometry-check.mjs",
    "test:odometry:native": "node scripts/native-odometry-check.mjs",
    "test:odometry:ui": "node scripts/odometry-ui-check.mjs",
    "test:unit-language": "node scripts/unit-language-check.mjs",
    "test:python-spin": "node scripts/python-spin-check.mjs",
    "test:product-regressions": "node scripts/product-regressions-check.mjs && node scripts/course-localization-check.mjs",
    "test:keyboard-focus": "node scripts/keyboard-focus-check.mjs",
    "test:long-output": "node scripts/long-output-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22"
  }
}
